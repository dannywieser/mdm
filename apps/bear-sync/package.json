{
  "name": "bear-sync",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "dist/cli.js",
  "scripts": {
    "prebuild": "turbo run build --filter=bear-sync^...",
    "presync": "turbo run build --filter=bear-sync^...",
    "pretest": "turbo run build --filter=bear-sync^...",
    "sync": "tsx --env-file=../../.env src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "markdown": "3.2.0",
    "mdm-util": "3.2.0"
  }
}
